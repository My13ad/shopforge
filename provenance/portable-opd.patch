+def runtime_paths(args):
+    """Resolve explicitly supplied runtimes while retaining the historical layout."""
+    root = args.shop_root.resolve()
+    return {name: Path(value or root / fallback).expanduser().resolve() for name, value, fallback in [
+        ('python', args.student_python, 'sft-venv/bin/python'),
+        ('teacher_python', args.teacher_python, 'teacher-vllm-venv/bin/python'),
+        ('model', args.student_model, 'model'),
+        ('teacher', args.teacher_model, 'teacher-qwen38-fp8')]}
+
+
+def verify_initial_adapter(adapter, reference_config, expected_sha256):
+    """A fresh SFT run must match an explicitly pinned reference and actual file."""
+    import re
+    if not isinstance(expected_sha256, str) or not re.fullmatch(r'[0-9a-f]{64}', expected_sha256):
+        raise ValueError('expected parent SHA-256 must be an explicit lowercase64 digest')
+    actual = sha(Path(adapter) / 'adapter_model.safetensors')
+    if actual != expected_sha256 or actual != reference_config['adapter_sha256']:
+        raise ValueError('SFT parent, reference evaluation and expected digest differ')
+    return actual
+
+
+def manifest_training_ids(path, train_ids, development_ids, final_ids, excluded_ids, seed, count):
+    selected = [row['task_id'] for row in rows(path)]
+    if len(selected) != count or any(type(t) is not int for t in selected):
+        raise ValueError('frozen OPD task manifest has an unexpected size or ID type')
+    return choose_training_ids(train_ids, development_ids, final_ids, excluded_ids,
+                               seed, count, prefix_ids=selected)
 
 
